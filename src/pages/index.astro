---
import '../styles/global.css';

const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const absoluteOgImage = Astro.site ? new URL('/images/og.webp', Astro.site).href : undefined;
const mapLink = 'https://maps.app.goo.gl/CA3f8Smjrz2yFwmv9';
const mapEmbed = 'https://www.google.com/maps?q=Pura+Taman+Ayun,+Jl.+Ayodya+No.10,+Mengwi,+Bali+80351&output=embed&hl=id&region=ID';

// Format nama situs SEO: "Nama Objek + Kota + Panduan Wisata".
const SITE_NAME = 'Pura Taman Ayun (Taman Ayun Temple) Bali — Panduan Wisata';

const faqs = [
  {
    q: 'Berapa lama waktu yang ideal untuk mengunjungi Pura Taman Ayun?',
    a: 'Sediakan sekitar 1–2 jam agar cukup waktu untuk berjalan di taman, melihat kolam dan kompleks meru, serta menikmati suasana tanpa terburu-buru.'
  },
  {
    q: 'Apa pakaian yang sebaiknya dipakai?',
    a: 'Gunakan pakaian yang sopan dan menghormati tempat ibadah. Tutupi bahu dan lutut; ikuti arahan petugas mengenai penggunaan kamen atau selendang di area tertentu.'
  },
  {
    q: 'Kapan waktu terbaik datang?',
    a: 'Pagi hari umumnya paling nyaman: udara lebih sejuk, cahaya lebih lembut, dan waktu kunjungan lebih leluasa sebelum siang.'
  },
  {
    q: 'Apakah tersedia area parkir?',
    a: 'Tersedia area parkir di sekitar pintu masuk. Tarif dan pengaturan dapat berubah, jadi siapkan uang kecil dan ikuti petunjuk petugas setempat.'
  },
  {
    q: 'Apakah tiket bisa berubah?',
    a: 'Ya. Tarif yang ditampilkan adalah acuan perencanaan dan dapat berubah. Konfirmasikan harga terbaru di loket ketika berkunjung.'
  }
];

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Pura Taman Ayun',
  alternateName: 'Taman Ayun Temple',
  description: 'Pura air kerajaan Mengwi di Bali, dikelilingi kolam dan taman dengan deretan meru bertingkat, bagian dari Lanskap Budaya Provinsi Bali yang diakui UNESCO.',
  ...(siteUrl ? { url: siteUrl.href } : {}),
  ...(absoluteOgImage ? { image: [absoluteOgImage] } : {}),
  hasMap: mapLink,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Ayodya No.10',
    addressLocality: 'Mengwi',
    addressRegion: 'Bali',
    postalCode: '80351',
    addressCountry: 'ID'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.54185,
    longitude: 115.17249
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '18:15'
    }
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.6',
    reviewCount: '9732',
    bestRating: '5'
  },
  priceRange: 'Rp'
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#20251f" />
    <title>{SITE_NAME} | Tiket, Jam Buka &amp; Transportasi</title>
    <meta name="description" content="Panduan berkunjung ke Pura Taman Ayun (Taman Ayun Temple) di Mengwi, Bali: tiket masuk, jam buka, sejarah, transportasi, foto, peta, dan FAQ bagi wisatawan." />
    {siteUrl && <link rel="canonical" href={siteUrl.href} />}
    {siteUrl && <link rel="alternate" hreflang="id" href={siteUrl.href} />}
    {siteUrl && <link rel="alternate" hreflang="x-default" href={siteUrl.href} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={SITE_NAME} />
    <meta property="og:description" content="Panduan lokal untuk menjelajahi pura air kerajaan Mengwi, taman, kolam, meru, dan jejak sistem subak Bali." />
    {siteUrl && <meta property="og:url" content={siteUrl.href} />}
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <!-- Google Analytics 4 — diminta secara eksplisit untuk situs ini. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#171c18]/88 text-[#fbf6ec] backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 lg:px-8">
        <a href="#atas" class="flex items-center gap-3" aria-label="Pura Taman Ayun, kembali ke atas">
          <svg viewBox="0 0 66 52" class="h-10 w-12" aria-hidden="true">
            <path d="M33 3 24 9h18L33 3Zm0 8L21 18h24L33 11Zm0 9L18 28h30L33 20Zm0 10L14 40h38L33 30Z" fill="#f3ead8" />
            <path d="M14 47c6-4 12-4 18 0s12 4 18 0" fill="none" stroke="#c99b4c" stroke-width="3" stroke-linecap="round" />
          </svg>
          <span class="leading-none">
            <strong class="display block text-lg font-bold tracking-wide">Taman Ayun</strong>
            <span class="text-[10px] uppercase tracking-[.24em] text-[#d9cba9]">Mengwi · Bali</span>
          </span>
        </a>
        <nav aria-label="Navigasi utama" class="hidden items-center gap-6 text-sm text-[#eee4d2] lg:flex">
          <a class="transition hover:text-white" href="#warisan">Warisan</a>
          <a class="transition hover:text-white" href="#kunjungan">Kunjungan</a>
          <a class="transition hover:text-white" href="#peta">Peta</a>
          <a class="transition hover:text-white" href="#sekitar">Sekitar</a>
          <a class="transition hover:text-white" href="#faq">FAQ</a>
        </nav>
        <a href={mapLink} target="_blank" rel="noreferrer" class="rounded-full border border-[#c99b4c]/70 px-4 py-2 text-xs font-semibold uppercase tracking-[.13em] transition hover:bg-[#c99b4c] hover:text-[#171c18]">Petunjuk arah</a>
      </div>
    </header>

    <main id="atas">
      <section class="relative min-h-[92svh] overflow-hidden bg-[#171c18] text-white">
        <img src="/images/hero.webp" alt="Deretan meru bertingkat di Pura Taman Ayun, Mengwi" class="absolute inset-0 h-full w-full object-cover object-center" width="2200" height="1467" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,18,12,.82)_0%,rgba(10,18,12,.55)_44%,rgba(10,18,12,.12)_78%),linear-gradient(0deg,rgba(10,18,12,.8)_0%,transparent_35%)]"></div>
        <div class="absolute right-0 top-24 hidden h-[78%] w-28 opacity-70 lg:block water-lines"></div>

        <div class="relative mx-auto flex min-h-[92svh] max-w-7xl items-end px-5 pb-16 pt-32 lg:px-8 lg:pb-20">
          <div class="grid w-full gap-10 lg:grid-cols-[1.2fr_.55fr] lg:items-end">
            <div class="max-w-4xl">
              <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[.26em] text-[#e2c88c]"><span class="h-px w-10 bg-[#e2c88c]"></span>Pura air kerajaan Mengwi</p>
              <h1 class="text-[clamp(3.4rem,9vw,8.8rem)] font-bold leading-[.8] tracking-[-.05em]">Taman<br /><span class="italic text-[#f0dfb6]">Ayun</span></h1>
              <p class="mt-8 max-w-2xl text-base leading-7 text-[#eee9de] sm:text-lg">Di balik parit air dan taman yang tenang, atap-atap <em>meru</em> menjulang seperti siluet gunung. Inilah pura keluarga Kerajaan Mengwi—sebuah lanskap suci tempat arsitektur, air, dan filosofi Bali bertemu.</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#kunjungan" class="rounded-full bg-[#f3ead8] px-6 py-3 text-sm font-bold text-[#20251f] transition hover:bg-white">Rencanakan kunjungan</a>
                <a href="#warisan" class="rounded-full border border-white/45 px-6 py-3 text-sm font-bold text-white transition hover:border-white hover:bg-white/10">Kenali warisannya</a>
              </div>
            </div>
            <aside class="border-l border-white/25 pl-5 text-sm text-[#f0eadf] lg:mb-1">
              <p class="mb-5 text-[10px] font-bold uppercase tracking-[.26em] text-[#e2c88c]">Sekilas</p>
              <dl class="grid grid-cols-2 gap-x-4 gap-y-5 lg:grid-cols-1">
                <div><dt class="text-white/55">Alamat</dt><dd class="mt-1 font-semibold">Jl. Ayodya No.10, Mengwi</dd></div>
                <div><dt class="text-white/55">Jam tercantum</dt><dd class="mt-1 font-semibold">08.00–18.15 · setiap hari</dd></div>
                <div><dt class="text-white/55">Peringkat Google</dt><dd class="mt-1 font-semibold">4,6 / 5 · dapat berubah</dd></div>
                <div><dt class="text-white/55">Karakter</dt><dd class="mt-1 font-semibold">Pura · taman · kolam · meru</dd></div>
              </dl>
            </aside>
          </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-2 bg-[linear-gradient(90deg,#914733_0_22%,#c99b4c_22%_28%,#405740_28%_76%,#dce9e4_76%)]"></div>
      </section>

      <section class="kamen-grid border-b border-[#20251f]/10 bg-[#f3ead8]">
        <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-[#20251f]/12 px-5 sm:grid-cols-4 sm:divide-y-0 lg:px-8">
          <div class="py-7 pr-4"><p class="display text-3xl font-bold">1634</p><p class="mt-1 text-xs uppercase tracking-[.14em] text-[#6f3529]">tahun pendirian yang dicatat Badung</p></div>
          <div class="px-4 py-7"><p class="display text-3xl font-bold">UNESCO</p><p class="mt-1 text-xs uppercase tracking-[.14em] text-[#6f3529]">bagian Lanskap Budaya Bali</p></div>
          <div class="px-4 py-7"><p class="display text-3xl font-bold">Meru</p><p class="mt-1 text-xs uppercase tracking-[.14em] text-[#6f3529]">atap bertingkat khas kompleks suci</p></div>
          <div class="py-7 pl-4"><p class="display text-3xl font-bold">Subak</p><p class="mt-1 text-xs uppercase tracking-[.14em] text-[#6f3529]">air, ritual, pertanian, kebersamaan</p></div>
        </div>
      </section>

      <section id="warisan" class="anchor-offset mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
        <div class="grid gap-14 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.24em] text-[#914733]">Warisan yang hidup</p>
            <h2 class="mt-5 text-5xl font-bold leading-[.96] tracking-[-.04em] sm:text-6xl">Air bukan sekadar latar.</h2>
            <p class="mt-7 max-w-lg text-lg leading-8 text-[#455047]">Pura Taman Ayun memperlihatkan bagaimana ruang suci Bali terhubung dengan air dan tatanan agraris. UNESCO menempatkannya dalam Lanskap Budaya Provinsi Bali—representasi sistem <em>subak</em> dan filosofi Tri Hita Karana.</p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <article class="border-t-4 border-[#405740] bg-[#dce9e4] p-7 sm:translate-y-12">
              <span class="display text-6xl italic text-[#405740]/28">01</span>
              <h3 class="mt-8 text-2xl font-bold">Pura kerajaan</h3>
              <p class="mt-4 leading-7 text-[#425047]">Pemerintah Kabupaten Badung mencatat pembangunan Pura Taman Ayun pada 1634 oleh penguasa Mengwi. Kompleks ini menjadi pura keluarga kerajaan sekaligus penanda penting sejarah Mengwi.</p>
            </article>
            <article class="border-t-4 border-[#914733] bg-[#f3ead8] p-7">
              <span class="display text-6xl italic text-[#914733]/25">02</span>
              <h3 class="mt-8 text-2xl font-bold">Meru dan halaman berlapis</h3>
              <p class="mt-4 leading-7 text-[#4e493f]">Deretan meru dengan jumlah tingkat berbeda membentuk ritme vertikal yang khas. Pengunjung mengamati kompleks sakral dari jalur yang menjaga batas antara ruang kunjungan dan area pemujaan.</p>
            </article>
            <article class="border-t-4 border-[#c99b4c] bg-[#20251f] p-7 text-[#f7efe0] sm:col-span-2 sm:ml-24">
              <div class="grid gap-5 sm:grid-cols-[.35fr_1fr] sm:items-end">
                <span class="display text-7xl italic text-[#c99b4c]">03</span>
                <div><h3 class="text-2xl font-bold">Parit air, taman, dan keseimbangan</h3><p class="mt-4 leading-7 text-[#ddd7ca]">Kolam yang mengelilingi pura bukan sekadar elemen visual. Dalam sejarah kawasan, air berkaitan dengan irigasi dan jaringan subak—hubungan nyata antara manusia, lingkungan, dan kehidupan spiritual.</p></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="overflow-hidden bg-[#171c18] text-[#f7efe0]">
        <div class="mx-auto grid max-w-[92rem] lg:grid-cols-2">
          <figure class="relative min-h-[560px]">
            <img src="/images/meru.webp" alt="Meru bertingkat di kompleks Pura Taman Ayun" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            <figcaption class="absolute bottom-5 left-5 rounded-full bg-black/55 px-4 py-2 text-xs backdrop-blur">Meru: lapisan atap yang membentuk langit Taman Ayun</figcaption>
          </figure>
          <div class="flex items-center px-6 py-16 sm:px-12 lg:px-16">
            <div class="max-w-xl">
              <p class="text-xs font-bold uppercase tracking-[.25em] text-[#d4ad65]">Lihat perlahan</p>
              <h2 class="mt-5 text-5xl font-bold leading-none sm:text-6xl">Baca lanskap dari bawah ke atas.</h2>
              <p class="mt-7 text-lg leading-8 text-[#d8d5cc]">Mulai dari garis air, lanjut ke gerbang batu, halaman hijau, lalu biarkan mata mengikuti susunan atap meru. Taman Ayun paling berkesan bukan ketika dikejar sebagai daftar foto, tetapi ketika ruangnya dibaca sebagai satu komposisi.</p>
              <div class="mt-10 grid grid-cols-2 gap-5 border-t border-white/15 pt-6 text-sm">
                <div><strong class="block text-[#e1bd75]">Etika</strong><span class="mt-2 block text-white/70">Jaga suara, hormati upacara, ikuti batas area.</span></div>
                <div><strong class="block text-[#e1bd75]">Busana</strong><span class="mt-2 block text-white/70">Bahu & lutut tertutup; ikuti arahan kamen/selendang.</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="kunjungan" class="anchor-offset bg-[#f3ead8] py-24 lg:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="flex flex-col gap-5 border-b border-[#20251f]/15 pb-8 md:flex-row md:items-end md:justify-between">
            <div><p class="text-xs font-bold uppercase tracking-[.25em] text-[#914733]">Rencana kunjungan</p><h2 class="mt-4 text-5xl font-bold tracking-[-.04em] sm:text-6xl">Praktis, tanpa mengurangi rasa hormat.</h2></div>
            <p class="max-w-md text-sm leading-6 text-[#5d5a51]">Jam, tarif, dan pengaturan lokal dapat berubah. Gunakan angka di bawah sebagai acuan perencanaan dan konfirmasi saat tiba.</p>
          </div>

          <div class="mt-10 grid gap-4 lg:grid-cols-3">
            <article class="bg-[#fbf6ec] p-7 lg:row-span-2">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-[#6f3529]">Tiket / biaya</p>
              <div class="mt-8 space-y-5">
                <div class="flex items-baseline justify-between gap-4 border-b border-[#20251f]/10 pb-4"><span>WNI dewasa</span><strong class="display text-2xl">Rp15.000</strong></div>
                <div class="flex items-baseline justify-between gap-4 border-b border-[#20251f]/10 pb-4"><span>WNI anak</span><strong class="display text-2xl">Rp10.000</strong></div>
                <div class="flex items-baseline justify-between gap-4 border-b border-[#20251f]/10 pb-4"><span>WNA dewasa</span><strong class="display text-2xl">Rp30.000</strong></div>
                <div class="flex items-baseline justify-between gap-4"><span>WNA anak</span><strong class="display text-2xl">Rp15.000</strong></div>
              </div>
              <p class="mt-8 text-xs leading-5 text-[#6c695f]">Acuan tarif dari Indonesia.travel. Harga aktual, kategori usia, atau paket fasilitas dapat berubah di loket.</p>
            </article>

            <article class="bg-[#405740] p-7 text-white">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-[#dce9e4]">Jam buka tercantum</p>
              <p class="display mt-7 text-5xl font-bold">08.00</p>
              <p class="display text-3xl italic text-[#dbe3d7]">hingga 18.15</p>
              <p class="mt-6 text-sm text-white/70">Setiap hari menurut listing Google saat riset. Upacara atau kebijakan lokal dapat memengaruhi akses.</p>
            </article>

            <article class="bg-[#dce9e4] p-7">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-[#405740]">Waktu terbaik</p>
              <p class="display mt-7 text-4xl font-bold">Pagi hari</p>
              <p class="mt-4 leading-7 text-[#465348]">Datang lebih awal untuk udara yang lebih nyaman dan cahaya lembut di taman, kolam, serta atap meru.</p>
            </article>

            <article class="bg-[#914733] p-7 text-white">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-[#f1d7bd]">Durasi yang disarankan</p>
              <p class="display mt-7 text-5xl font-bold">1–2 jam</p>
              <p class="mt-4 text-sm leading-6 text-white/75">Cukup untuk berjalan santai, melihat detail arsitektur, berfoto, dan berhenti menikmati taman.</p>
            </article>

            <article class="bg-[#20251f] p-7 text-white">
              <p class="text-xs font-bold uppercase tracking-[.2em] text-[#d4ad65]">Parkir</p>
              <p class="display mt-7 text-4xl font-bold">Dekat pintu masuk</p>
              <p class="mt-4 text-sm leading-6 text-white/70">Area parkir tersedia di sekitar kompleks. Tarif dapat berubah; ikuti petugas dan siapkan uang kecil.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="bg-[#fbf6ec] py-24">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-6 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
            <div><p class="text-xs font-bold uppercase tracking-[.25em] text-[#914733]">Galeri</p><h2 class="mt-4 text-5xl font-bold leading-none">Batu, air, dan taman.</h2></div>
            <p class="max-w-2xl text-base leading-7 text-[#565d55]">Seluruh foto destinasi di halaman ini disimpan lokal di proyek. Tidak ada hotlink gambar eksternal.</p>
          </div>
          <div class="mt-10 grid auto-rows-[250px] gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <figure class="relative overflow-hidden sm:row-span-2 lg:col-span-2"><img src="/images/courtyard.webp" alt="Halaman dan meru Pura Taman Ayun" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
            <figure class="relative overflow-hidden"><img src="/images/gate.webp" alt="Gerbang batu Pura Taman Ayun" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
            <figure class="relative overflow-hidden"><img src="/images/bridge.webp" alt="Detail jembatan berukir di Taman Ayun" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
            <figure class="relative overflow-hidden lg:col-span-2"><img src="/images/fountain.webp" alt="Air mancur dan taman hijau di Taman Ayun" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
            <figure class="relative overflow-hidden sm:col-span-2 lg:col-span-4"><img src="/images/garden.webp" alt="Taman di kawasan Pura Taman Ayun" loading="lazy" class="h-full w-full object-cover transition duration-700 hover:scale-[1.02]" /></figure>
          </div>
        </div>
      </section>

      <section id="peta" class="anchor-offset bg-[#dce9e4] py-24 lg:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[.62fr_1.38fr] lg:items-start">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.25em] text-[#405740]">Arah & transportasi</p>
              <h2 class="mt-4 text-5xl font-bold tracking-[-.04em]">Menuju Mengwi.</h2>
              <div class="mt-8 space-y-7 text-[#475448]">
                <div class="border-t border-[#405740]/25 pt-5"><h3 class="text-xl font-bold">Dari Bandara Ngurah Rai (DPS)</h3><p class="mt-2 leading-7">Indonesia.travel memperkirakan sekitar 45–60 menit dari Bandara Internasional I Gusti Ngurah Rai ke Mengwi, bergantung kepadatan lalu lintas di Kuta, Jimbaran, dan Denpasar. Pilihan praktis: taksi bandara, taksi daring, atau mobil sewaan dengan pengemudi agar bisa menggabungkan perjalanan dengan titik lain di Bali.</p></div>
                <div class="border-t border-[#405740]/25 pt-5"><h3 class="text-xl font-bold">Dari Denpasar / Ubud</h3><p class="mt-2 leading-7">Indonesia.travel memperkirakan sekitar 1 jam dengan mobil atau taksi, bergantung titik berangkat dan kondisi lalu lintas. Kendaraan sewaan dengan pengemudi juga praktis untuk menggabungkan beberapa tujuan.</p></div>
                <div class="border-t border-[#405740]/25 pt-5"><h3 class="text-xl font-bold">Motor / mobil sewaan</h3><p class="mt-2 leading-7">Masukkan alamat lengkap Jl. Ayodya No.10, Mengwi. Jalan utama menuju Mengwi mudah diikuti, tetapi sisakan waktu ekstra pada jam padat.</p></div>
                <div class="border-t border-[#405740]/25 pt-5"><h3 class="text-xl font-bold">Catatan akses</h3><p class="mt-2 leading-7">Listing Google saat riset menandai pintu masuk dan parkir sebagai tidak ramah kursi roda. Pengunjung yang memerlukan akses khusus sebaiknya mengonfirmasi kondisi terkini sebelum datang.</p></div>
              </div>
              <a href={mapLink} target="_blank" rel="noreferrer" class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#20251f] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#914733]">Buka di Google Maps <span aria-hidden="true">↗</span></a>
            </div>
            <div class="map-frame overflow-hidden rounded-t-[5rem] border-[10px] border-[#fbf6ec] bg-[#fbf6ec] shadow-[0_30px_70px_rgba(27,48,36,.16)]">
              <iframe title="Peta Pura Taman Ayun, Mengwi" src={mapEmbed} loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
              <div class="flex flex-wrap items-center justify-between gap-3 bg-[#fbf6ec] px-5 py-4 text-xs text-[#5b645c]"><span>Jl. Ayodya No.10, Mengwi, Badung, Bali 80351</span><span class="font-bold uppercase tracking-[.13em] text-[#914733]">Bahasa peta: Indonesia</span></div>
            </div>
          </div>
        </div>
      </section>

      <section id="sekitar" class="anchor-offset bg-[#20251f] py-24 text-[#f7efe0] lg:py-28">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-12 lg:grid-cols-[.6fr_1.4fr]">
            <div><p class="text-xs font-bold uppercase tracking-[.25em] text-[#d4ad65]">Setelah dari pura</p><h2 class="mt-4 text-5xl font-bold leading-none">Mengwi masih punya cerita.</h2><p class="mt-6 max-w-md leading-7 text-white/65">Kombinasikan situs utama dengan rasa lokal, museum kecil, dan ritme pasar. Semua pilihan di bawah berada di kawasan Mengwi; jam dan operasional dapat berubah.</p></div>
            <div class="grid gap-5 md:grid-cols-2">
              <article class="border border-white/15 p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-[#d4ad65]">Kuliner · dekat kompleks</p><h3 class="mt-5 text-3xl font-bold">Warung Sate Bu Rai</h3><p class="mt-3 leading-7 text-white/65">Pilihan warung Bali yang sangat dekat dari Taman Ayun. Cocok untuk makan sederhana setelah berkeliling.</p><p class="mt-5 text-sm font-semibold text-[#e9d4a6]">Jl. I Gusti Ketut Jelantik No.1</p></article>
              <article class="border border-white/15 p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-[#d4ad65]">Kopi · santai</p><h3 class="mt-5 text-3xl font-bold">Greenbumi Cafe</h3><p class="mt-3 leading-7 text-white/65">Tempat rehat di kawasan Mengwi untuk kopi dan jeda yang lebih panjang sebelum melanjutkan perjalanan.</p><p class="mt-5 text-sm font-semibold text-[#e9d4a6]">Jl. Gulingan, Mengwitani</p></article>
              <article class="border border-white/15 p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-[#a7c5ab]">Budaya · museum</p><h3 class="mt-5 text-3xl font-bold">The Ogoh Ogoh Bali Museum</h3><p class="mt-3 leading-7 text-white/65">Museum kecil dekat Taman Ayun yang memperkenalkan figur ogoh-ogoh dan ekspresi budaya Bali.</p><p class="mt-5 text-sm font-semibold text-[#bcd4bf]">Jl. Ayodya No.1, Mengwi</p></article>
              <article class="border border-white/15 p-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-[#a7c5ab]">Lokal · pasar</p><h3 class="mt-5 text-3xl font-bold">Pasar Mengwi</h3><p class="mt-3 leading-7 text-white/65">Lihat sisi sehari-hari Mengwi melalui pasar tradisional dan aktivitas warga di pusat kawasan.</p><p class="mt-5 text-sm font-semibold text-[#bcd4bf]">Jl. Rama, Mengwi</p></article>
            </div>
          </div>

          <div class="mt-16 border-t border-white/15 pt-12">
            <p class="text-xs font-bold uppercase tracking-[.25em] text-[#d4ad65]">Tempat menarik di sekitar</p>
            <div class="mt-7 grid gap-6 md:grid-cols-3">
              <div><span class="display text-5xl italic text-white/15">01</span><h3 class="mt-3 text-2xl font-bold">Museum Yadnya</h3><p class="mt-2 text-sm leading-6 text-white/60">Tambahan singkat untuk mengenal tradisi upacara dan kebudayaan Bali di area Mengwi.</p></div>
              <div><span class="display text-5xl italic text-white/15">02</span><h3 class="mt-3 text-2xl font-bold">Puri Ageng Mengwi</h3><p class="mt-2 text-sm leading-6 text-white/60">Jejak pusat kerajaan Mengwi yang memberi konteks historis bagi keberadaan Taman Ayun.</p></div>
              <div><span class="display text-5xl italic text-white/15">03</span><h3 class="mt-3 text-2xl font-bold">Jalur budaya Mengwi</h3><p class="mt-2 text-sm leading-6 text-white/60">Susun perjalanan pendek antara pura, museum, pasar, dan warung agar kunjungan terasa sebagai pengalaman kawasan, bukan satu titik.</p></div>
            </div>
          </div>
        </div>
      </section>

      <section id="faq" class="anchor-offset bg-[#fbf6ec] py-24 lg:py-28">
        <div class="mx-auto max-w-5xl px-5 lg:px-8">
          <div class="text-center"><p class="text-xs font-bold uppercase tracking-[.25em] text-[#914733]">FAQ</p><h2 class="mt-4 text-5xl font-bold tracking-[-.04em]">Sebelum berangkat.</h2></div>
          <div class="mt-12 divide-y divide-[#20251f]/15 border-y border-[#20251f]/15">
            {faqs.map((faq, i) => (
              <details class="group py-6">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-5 text-left">
                  <span class="flex gap-4"><span class="display text-lg italic text-[#914733]">0{i + 1}</span><strong class="text-lg sm:text-xl">{faq.q}</strong></span>
                  <span class="text-2xl transition group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="ml-10 mt-4 max-w-3xl leading-7 text-[#596159]">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-[#f3ead8] py-16">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
            <div><p class="text-xs font-bold uppercase tracking-[.25em] text-[#914733]">Sumber & kredit</p><h2 class="mt-4 text-3xl font-bold">Dibuat dari sumber yang dapat ditelusuri.</h2></div>
            <div class="grid gap-6 text-sm leading-6 text-[#625e54] sm:grid-cols-2">
              <div><strong class="text-[#20251f]">Informasi destinasi</strong><p class="mt-2">UNESCO World Heritage Centre; Indonesia.travel; Dinas Kebudayaan Kabupaten Badung; listing Google untuk alamat, jam, rating, dan fasilitas.</p></div>
              <div><strong class="text-[#20251f]">Foto</strong><p class="mt-2">Foto utama: Cindi CGJ, Wikimedia Commons, CC BY-SA 4.0. Foto meru, halaman, gerbang, jembatan, air mancur, dan taman: Anandajoti, Wikimedia Commons, CC BY-SA 4.0. Gambar dikompresi ke WebP tanpa hotlink.</p></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#171c18] text-[#d9d4c8]">
      <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
        <div class="flex flex-col gap-8 border-b border-white/10 pb-9 md:flex-row md:items-center md:justify-between">
          <img src="/logo.svg" alt="Pura Taman Ayun" class="h-auto w-64 brightness-[2.3] grayscale" width="320" height="88" />
          <a href="#atas" class="text-xs font-bold uppercase tracking-[.2em] text-[#d4ad65]">Kembali ke atas ↑</a>
        </div>
        <div class="flex flex-col gap-4 pt-7 text-xs leading-5 text-white/45 md:flex-row md:items-end md:justify-between">
          <p class="max-w-2xl">Situs panduan independen dan tidak resmi; tidak mewakili pengelola Pura Taman Ayun, Pemerintah Kabupaten Badung, UNESCO, maupun lembaga resmi lainnya.</p>
          <p>Hormati tempat suci · jaga kebersihan · ikuti arahan lokal</p>
        </div>
      </div>
    </footer>
  </body>
</html>
